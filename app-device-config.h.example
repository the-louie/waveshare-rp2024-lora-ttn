/*
 * LoRaWAN OTAA credentials. Copy this file to app-device-config.h and fill from TTN Console.
 * Do not commit app-device-config.h with real keys to a public repo.
 * EU868 / TTN EU.
 *
 * RadioLib format (for beginOTAA):
 *   JoinEUI/DevEUI: uint64_t, MSB (literal) = paste hex from TTN as 0x...ULL.
 *   AppKey/NwkKey: uint8_t[], MSB (big-endian) C-style array; paste from TTN.
 */
#ifndef WAVESHARE_RP2040_LORA_TTN_APP_DEVICE_CONFIG_H
#define WAVESHARE_RP2040_LORA_TTN_APP_DEVICE_CONFIG_H

/* EUIs: MSB (human-readable) literal; copy hex from TTN (e.g. 0000000000000000 -> 0x0000000000000000ULL). */
#define LORAWAN_JOIN_EUI  0x0000000000000000ULL
#define LORAWAN_DEV_EUI   0x0000000000000000ULL

/* Keys: MSB (big-endian) C-style array; MUST match TTN for the DevEUI above. MIC mismatch = wrong key. */
#define LORAWAN_APP_KEY   { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

#endif
